%% Plot unit responses in CCF

% Get trial stim values
trial_stim_values = vertcat(trial_events.values.TrialStimX);
trial_stim_values = trial_stim_values(1:length(stimOn_times));

% Get quiescent trials
stim_window = [0,0.5];
quiescent_trials = arrayfun(@(x) ~any(wheel_move(...
    timelite.timestamps >= stimOn_times(x)+stim_window(1) & ...
    timelite.timestamps <= stimOn_times(x)+stim_window(2))), ...
    (1:length(stimOn_times))');

% Get stim response for each unit (post-pre stim)
stim_align_times = arrayfun(@(x) stimOn_times(trial_stim_values == x & quiescent_trials), ...
    unique(trial_stim_values),'uni',false);

unit_resp_stim_t = [0.05,0.15];

[~,baseline_spikes] = ap.psth(spike_times_timelite,stim_align_times,spike_templates, ...
    'window',-mean(unit_resp_stim_t),'bin_size',diff(unit_resp_stim_t));
[~,event_spikes] = ap.psth(spike_times_timelite,stim_align_times,spike_templates, ...
    'window',mean(unit_resp_stim_t),'bin_size',diff(unit_resp_stim_t));

event_spikes_meandiff = cellfun(@(event,baseline) ...
    squeeze(mean(diff([baseline,event],[],2),1)), ...
    event_spikes,baseline_spikes,'uni',false);

% Plot brain outline
ap.ccf_outline_3d;
% Plot all units as small points
scatter3(template_ccf(:,1),template_ccf(:,3),template_ccf(:,2),5,[0.5,0.5,0.5],'filled');
% Plot unit response center/right as semi-transparent scaled/colored points
scatter3(template_ccf(:,1),template_ccf(:,3),template_ccf(:,2),1*max(event_spikes_meandiff{2},0)+1,'b','filled','MarkerFaceAlpha',0.5);
scatter3(template_ccf(:,1),template_ccf(:,3),template_ccf(:,2),1*max(event_spikes_meandiff{3},0)+1,'r','filled','MarkerFaceAlpha',0.5);


%% probe line fitting

% NOTE - this doesn't work at the moment, fitting a smoothed spline results
% in a crazy curve

% (working on this function)
ap_histology.fit_probe_line(histology_filename, ...
    histology_annotation_match(histology_annotation_shanksort));



% Sort points by depth
curr_probe_points = sortrows(probe_ccf_vertices{curr_probe},2);

% Fit 3D smoothed spline
smoothing_param = 0.1; % 0 (straight line) - 1 (no smoothing)

% eval_points_probe = (1:size(curr_points,1))';

max_eval = round(sqrt(max(size(av)).^2*2));
eval_points_probe = (-max_eval:max_eval);

% eval_points_probe = (-100:100)';

ft = fittype('smoothingspline');
curr_probe_points_smoothed = nan(length(eval_points_probe),3);
for curr_dim = 1:size(curr_probe_points,2)
    probe_fit_dim = fit(vecnorm(curr_probe_points - curr_probe_points(end,:),2,2), ...
        curr_probe_points(:,curr_dim), ft, 'SmoothingParam', smoothing_param);
    curr_probe_points_smoothed(:,curr_dim) = probe_fit_dim(eval_points_probe);
end





eval_points_ccf = round(interp1([0,norm(diff(probe_vector))],probe_vector, ...
    eval_points_probe,'linear','extrap'));

eval_points_ccf_valid = eval_points_ccf(all(eval_points_ccf > 0 & eval_points_ccf <= size(av),2),:);

eval_points_ccf_idx = sub2ind(size(av),eval_points_ccf_valid(:,1), ...
    eval_points_ccf_valid(:,2),eval_points_ccf_valid(:,3));

probe_trajectory_av = av(eval_points_ccf_idx);

% Get insertion point: where fit intersects brain
probe_insertion_ccf_fit = eval_points_ccf_valid(find(probe_trajectory_av > 1,1),:);

% Get deepest point (tip): where fit is closest to deepest labeled point
[~,deepest_point_idx] = max(probe_ccf_vertices{curr_probe}(:,2));
probe_depth_ccf_labeled = probe_ccf_vertices{curr_probe}(deepest_point_idx,:);

probe_depth_ccf_fit = probe_vector(1,:) + ...
    ((probe_depth_ccf_labeled-probe_vector(1,:))*diff(probe_vector,[],1)').* ...
    diff(probe_vector,[],1);



%% OE remote control


oe = tcpclient(plab.local_rig.config.local.client, ...
    plab.locations.ephys_port,'ConnectTimeout',1);

animal = 'test';
rec_day = '2026-08-11';

recording_info = struct( ...
    'parent_directory', plab.locations.local_data_path, ...
    'base_text', animal, ...
    'append_text', rec_day, ...
    'default_record_engine', "BINARY", ...
    'start_new_directory', true);

% set recording path
oe_save_path = plab.locations.filename('local',animal);
mkdir(oe_save_path);
recording_info = struct( ...
    'parent_directory',oe_save_path, ...
    'record_engine', "BINARY", ...
    'start_new_directory', true);

openephys_url = sprintf('http://%s:%d/api/recording',oe.Address,oe.Port);
openephys_send_status = webwrite(openephys_url, recording_info, ...
    weboptions('RequestMethod','put','MediaType','application/json'));

% start recording
openephys_url = sprintf('http://%s:%d/api/status',oe.Address,oe.Port);
x = struct('mode','RECORD');
openephys_send_status = webwrite(openephys_url, x, ...
    weboptions('RequestMethod','put','MediaType','application/json'));

% stop recording (set to acquire)
openephys_url = sprintf('http://%s:%d/api/status',oe.Address,oe.Port);
x = struct('mode','ACQUIRE');
openephys_send_status = webwrite(openephys_url, x, ...
    weboptions('RequestMethod','put','MediaType','application/json'));



openephys_url = sprintf('http://%s:%d/api/recording',oe.Address,oe.Port);
openephys_send_status = webwrite(openephys_ur, ...
    weboptions('RequestMethod','GET','MediaType','application/json'));

