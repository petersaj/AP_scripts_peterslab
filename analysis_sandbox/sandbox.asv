%% Plot unit responses in CCF

% Get trial stim values
trial_stim_values = vertcat(trial_events.values.TrialStimX);
trial_stim_values = trial_stim_values(1:length(stimOn_times));

% Get quiescent trials
stim_window = [0,0.5];
quiescent_trials = arrayfun(@(x) ~any(wheel_move(...
    timelite.timestamps >= stimOn_times(x)+stim_window(1) & ...
    timelite.timestamps <= stimOn_times(x)+stim_window(2))), ...
    (1:length(stimOn_times))');

% Get stim response for each unit (post-pre stim)
stim_align_times = arrayfun(@(x) stimOn_times(trial_stim_values == x & quiescent_trials), ...
    unique(trial_stim_values),'uni',false);

unit_resp_stim_t = [0.05,0.15];

[~,baseline_spikes] = ap.psth(spike_times_timelite,stim_align_times,spike_templates, ...
    'window',-mean(unit_resp_stim_t),'bin_size',diff(unit_resp_stim_t));
[~,event_spikes] = ap.psth(spike_times_timelite,stim_align_times,spike_templates, ...
    'window',mean(unit_resp_stim_t),'bin_size',diff(unit_resp_stim_t));

event_spikes_meandiff = cellfun(@(event,baseline) ...
    squeeze(mean(diff([baseline,event],[],2),1)), ...
    event_spikes,baseline_spikes,'uni',false);

% Plot brain outline
ap.ccf_outline_3d;
% Plot all units as small points
scatter3(template_ccf(:,1),template_ccf(:,3),template_ccf(:,2),5,[0.5,0.5,0.5],'filled');
% Plot unit response center/right as semi-transparent scaled/colored points
scatter3(template_ccf(:,1),template_ccf(:,3),template_ccf(:,2),1*max(event_spikes_meandiff{2},0)+1,'b','filled','MarkerFaceAlpha',0.5);
scatter3(template_ccf(:,1),template_ccf(:,3),template_ccf(:,2),1*max(event_spikes_meandiff{3},0)+1,'r','filled','MarkerFaceAlpha',0.5);


%% probe line fitting

ap_histology.fit_probe_line(histology_filename, ...
    histology_annotation_match(histology_annotation_shanksort));

% Sort points by depth
curr_points = sortrows(probe_ccf_vertices{curr_probe},2);


% Fit 3D smoothed spline
eval_points = (1:size(curr_points,1))';
ft = fittype('smoothingspline');
smoothing_param = 0.5; % 0-1
curr_points_smoothed = 
fitresult_x = fit(eval_points, curr_points(:,1), ft, 'SmoothingParam', smoothing_param);
fitresult_y = fit(eval_points, curr_points(:,2), ft, 'SmoothingParam', smoothing_param);
fitresult_z = fit(eval_points, curr_points(:,3), ft, 'SmoothingParam', smoothing_param);



